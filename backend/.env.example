# Solo desarrollo local. Ejecuta python -m scripts.configure_local.
# La contraseña de PostgreSQL se introduce oculta en tu terminal.
DATABASE_URL='postgresql+psycopg://postgres:CAMBIAR_EN_LOCAL@127.0.0.1:5432/vestinova_mvp'
# Generado localmente por configure_local, al menos 32 caracteres aleatorios.
JWT_SECRET='GENERAR_LOCALMENTE_CON_CONFIGURE_LOCAL'
SESSION_MINUTES=120
CORS_ORIGINS='http://127.0.0.1:4201,http://localhost:4201'
# CU09: Stripe Checkout exclusivamente de prueba. Deja vacío hasta que el titular
# autorizado proporcione credenciales de sandbox por un canal seguro.
# No subir claves reales ni compartirlas en chats o capturas.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CU10: horas de vigencia de una reserva confirmada (1 a 720).
# Valor predeterminado de la API: 24 horas. Ajustar segun politica comercial.
RESERVATION_TTL_HOURS=24
# CU21: configura mediante python -m scripts.configure_ai; clave solo en .env local.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=
AI_API_KEY=

# CU26: completar localmente para probar recepción Web Push en una PWA.
# La clave privada permanece en el servidor; estos ejemplos no contienen claves.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=
